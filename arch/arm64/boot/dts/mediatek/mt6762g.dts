	md1_sim1_hot_plug_eint {
		phandle = <0xf2>;
		compatible = "mediatek,md1_sim1_hot_plug_eint-eint";
		interrupts = <0x00 0x08>;
		debounce = <0x00 0x2710>;
		dedicated = <0x00 0x00>;
		src_pin = <0x00 0x01>;
		sockettype = <0x00 0x00>;
		status = "okay";
	};

	md1_sim2_hot_plug_eint {
		phandle = <0xf3>;
		compatible = "mediatek,md1_sim2_hot_plug_eint-eint";
		interrupts = <0x01 0x08>;
		debounce = <0x01 0x2710>;
		dedicated = <0x01 0x00>;
		src_pin = <0x01 0x02>;
		sockettype = <0x01 0x00>;
		status = "okay";
	};

	cm_mgr@10200000 {
		compatible = "mediatek,mt6765-cm_mgr";
		reg = <0x00 0x10200000 0x00 0x4000>;
		reg-names = "cm_mgr_base";
		required-opps = <0x32 0x33 0x34>;
		cm_mgr,cp_down = <0x64 0x64>;
		cm_mgr,cp_up = <0x64 0x64>;
		cm_mgr,dt_down = <0x00 0x03>;
		cm_mgr,dt_up = <0x00 0x03>;
		cm_mgr,vp_down = <0x64 0x64>;
		cm_mgr,vp_up = <0x64 0x64>;
		phandle = <0xf4>;
	};

